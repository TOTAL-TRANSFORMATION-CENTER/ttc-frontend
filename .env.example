# ==============================================================================
# Total Transformation Center (TTC) Environment Configuration
# Copy this file to .env or .env.local and populate the values.
# ==============================================================================

# ─── DATABASE (PostgreSQL / Supabase / Neon / RDS) ───
# Connect to Postgres via connection pooling (used by Prisma Client runtime)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Direct connection to Postgres (required for Prisma migrations / DDL operations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ─── AUTHENTICATION & SECURITY ───
# 64-character random string for JWT signing and password HMAC pepper
AUTH_SECRET_KEY="generate_a_secure_64_character_hex_key_for_production"

# Bcrypt salt rounds (12 is recommended standard)
BCRYPT_SALT_ROUNDS=12

# Redux Persist Encryption Key (used on client side)
NEXT_PUBLIC_REDUX_PERSIST_KEY="secure_redux_encryption_key_change_in_production"

# ─── OPTIONAL: INITIAL ADMIN BOOTSTRAP (used by `npm run db:seed`) ───
INITIAL_ADMIN_NAME="Super Admin"
INITIAL_ADMIN_PHONE="+919876543210"
INITIAL_ADMIN_EMAIL="admin@ttcministries.org"
INITIAL_ADMIN_PASSWORD="Admin@TTC2026!"

# ─── YOUTUBE LIVE INTEGRATION ───
YOUTUBE_CHANNEL_ID="UC5PqpsjSxB_4AZoDA8y_PKg"
YOUTUBE_HANDLE="@TotalTransformationMinistries"

# ─── APPLICATION BASE URL ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
